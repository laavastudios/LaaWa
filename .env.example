# Owner authentication — set these in Vercel/Netlify environment variables.
LAAWA_OWNER_USERNAME=laavabee
LAAWA_OWNER_PASSWORD=change-this-before-production
LAAWA_SESSION_SECRET=generate-a-long-random-secret

# Google AI Studio / Gemini — server-side only. Never expose this in client code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional future persistence/integrations
DATABASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
