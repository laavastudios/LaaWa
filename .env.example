# LaaWa authentication
LAAWA_SESSION_SECRET=replace-with-a-long-random-secret
LAAWA_OWNER_USERNAME=
LAAWA_OWNER_PASSWORD=

# Core data store (PostgreSQL)
# Use the pooled runtime URL for the app and worker.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_POOL_MAX=10

# Optional default Gemini key (dashboard key is preferred)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp worker / multi-account manager
WHATSAPP_WORKER_URL=http://127.0.0.1:3010
WHATSAPP_MANAGER_URL=http://127.0.0.1:3020
WHATSAPP_WORKER_SECRET=replace-with-another-long-random-secret
WHATSAPP_WORKER_PORT=3010
WHATSAPP_WORKER_HOST=127.0.0.1
WHATSAPP_AUTH_PATH=./.whatsapp-session
WHATSAPP_MANAGER_PORT=3020
WHATSAPP_MANAGER_HOST=127.0.0.1
WHATSAPP_ACCOUNTS_FILE=./.whatsapp-accounts.json

# Optional remote Baileys engine adapter.
# Leave empty to keep the default WhatsApp Web.js runtime only.
BAILEYS_WORKER_URL=
